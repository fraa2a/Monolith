{
  "name": "monolith-desktop-ui",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "postbuild": "cargo build --release --features custom-protocol --manifest-path src-tauri/Cargo.toml",
    "build:dev": "vite build && cargo build --features custom-protocol --manifest-path src-tauri/Cargo.toml",
    "dev": "vite",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "test:ui": "node tests/ui.mjs && node tests/audit.mjs"
  },
  "dependencies": {
    "@preact/signals": "^1.3.0",
    "@tauri-apps/api": "^2",
    "preact": "^10.24.0"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.9.0",
    "@tauri-apps/cli": "^2",
    "playwright-core": "^1.64.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  }
}
